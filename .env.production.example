# Modèle pour .env.production — jamais commité une fois rempli (voir .gitignore).
# Consommé par docker-compose.prod.yml et deploy/*.sh. Aucune valeur ci-dessous n'est
# un secret réel.

# --- Base de données --------------------------------------------------------
POSTGRES_USER=maat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maat

# --- Jeton JWT ---------------------------------------------------------------
# docs/specs/deploiement.md, section 3 : aléatoire, >= 32 octets, jamais dérivé d'un
# mot de passe ni réutilisé d'un autre environnement. Générer avec :
#   openssl rand -base64 48
JWT_SIGNING_KEY=change-me-32-bytes-minimum
JWT_ISSUER=maat-api
JWT_AUDIENCE=maat-client
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=900

# --- Domaines et CORS ---------------------------------------------------------
# docs/specs/deploiement.md, section 1 : un seul domaine enregistrable, deux
# sous-domaines (cookie SameSite=Strict). Sans barre oblique finale sur FRONTEND_ORIGIN
# (section 3 — le défaut le plus fréquent du projet).
APP_DOMAIN=app.maat.fr
API_DOMAIN=api.maat.fr
FRONTEND_ORIGIN=https://app.maat.fr
ACME_EMAIL=admin@maat.fr

# --- Déploiement ---------------------------------------------------------------
# Moteur de conteneurs (ADR 0007) : "docker compose" ou "podman compose".
COMPOSE_CMD=podman compose
# Laissé vide par défaut : deploy.sh le fixe au sha court du commit déployé si absent.
IMAGE_TAG=

# --- Sauvegarde (deploy/backup.sh) --------------------------------------------
# Empreinte de la clé GPG publique du destinataire — chiffrement asymétrique, aucune
# phrase de passe stockée sur le VPS. La clé privée correspondante reste hors du VPS,
# détenue par la personne qui restaure (docs/deploiement/checklist.md).
BACKUP_GPG_RECIPIENT=change-me
# Remote rclone pointant vers un stockage objet en Union européenne (ex. OVHcloud
# Object Storage) — configuré une fois avec `rclone config`, jamais dans ce fichier.
RCLONE_REMOTE=ovh-eu:maat-backups
BACKUP_RETENTION_DAYS=30
