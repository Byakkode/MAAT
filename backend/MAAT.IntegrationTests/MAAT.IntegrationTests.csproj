<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Référence explicite : sans elle, ce projet résout Microsoft.EntityFrameworkCore.Relational
         via Npgsql.EntityFrameworkCore.PostgreSQL (plancher 10.0.4) au lieu de la version que
         Microsoft.EntityFrameworkCore.Design impose à MAAT.Api/MAAT.Infrastructure (10.0.10),
         car le PrivateAssets="all" de Design empêche cette contrainte de remonter jusqu'ici. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MAAT.Api\MAAT.Api.csproj" />
    <ProjectReference Include="..\MAAT.Infrastructure\MAAT.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fichiers d'exemple reproduisant chaque cas de robustesse CSV (CsvFileTests.cs) :
         BOM, CRLF, retour à la ligne dans un champ entre guillemets, export au format
         point-virgule, nombre de colonnes incorrect. -->
    <EmbeddedResource Include="SeedSamples\*.csv" />
  </ItemGroup>

</Project>